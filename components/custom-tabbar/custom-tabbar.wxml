<!-- components/custom-tabbar/custom-tabbar.wxml -->
<!-- 科技感自定义TabBar组件 -->
<view class="custom-tabbar" style="padding-bottom: {{safeAreaBottom}}px;">
  <!-- 顶部科技感光线 -->
  <view class="tech-glow-line"></view>
  
  <!-- TabBar内容 -->
  <view class="tabbar-content">
    
    <!-- 首页 - 推荐 -->
    <view 
      class="tabbar-item {{currentTab === 0 ? 'active' : ''}}" 
      data-index="0"
      bindtap="onTabTap"
    >
      <view class="item-icon">
        <image class="tab-icon" src="https://api.iconify.design/mdi:home-variant-outline.svg" mode="aspectFit"/>
      </view>
      <view class="item-text">推荐</view>
    </view>
    
    <!-- 研报 -->
    <view 
      class="tabbar-item {{currentTab === 1 ? 'active' : ''}}" 
      data-index="1"
      bindtap="onTabTap"
    >
      <view class="item-icon">
        <image class="tab-icon" src="https://api.iconify.design/mdi:file-document-outline.svg" mode="aspectFit"/>
      </view>
      <view class="item-text">研报</view>
    </view>
    
    <!-- 中间的AI智能体 -->
    <view 
      class="tabbar-item tabbar-item-middle {{currentTab === 2 ? 'active' : ''}}" 
      data-index="2"
      bindtap="onTabTap"
    >
      <view class="middle-container">
        <view class="middle-icon-wrapper">
          <image class="middle-icon-img" src="https://api.iconify.design/mdi:robot-outline.svg" mode="aspectFit"/>
        </view>
        <view class="middle-text">智演智能体</view>
      </view>
    </view>
    
    <!-- 活动 -->
    <view 
      class="tabbar-item {{currentTab === 3 ? 'active' : ''}}" 
      data-index="3"
      bindtap="onTabTap"
    >
      <view class="item-icon">
        <image class="tab-icon" src="https://api.iconify.design/mdi:calendar-blank-outline.svg" mode="aspectFit"/>
      </view>
      <view class="item-text">活动</view>
    </view>
    
    <!-- 数据 -->
    <view 
      class="tabbar-item {{currentTab === 4 ? 'active' : ''}}" 
      data-index="4"
      bindtap="onTabTap"
    >
      <view class="item-icon">
        <image class="tab-icon" src="https://api.iconify.design/mdi:chart-line-variant.svg" mode="aspectFit"/>
      </view>
      <view class="item-text">数据</view>
    </view>
    
  </view>
</view>
