<!-- pages/ai-agent/ai-agent.wxml -->
<view class="page-container">
  
  <!-- AI智能体主界面 -->
  <view class="ai-agent-container">
    <!-- 头部标题区 - 欢迎动画 -->
    <view class="ai-header-section {{headerCollapsed ? 'collapsed' : ''}}">
      <view class="header-top-bar">
        <view class="header-title">
          <text class="ai-name">智演智能体</text>
          <text class="ai-description">您的专属期货投研助手</text>
        </view>
      </view>
      
      <!-- 快捷智能体入口 -->
      <view class="quick-agents-section">
        <text class="section-label">AGENT</text>
        <scroll-view class="quick-agents-scroll" scroll-x>
          <view class="quick-agents-list">
            <block wx:for="{{hotAgents}}" wx:key="id">
              <view class="quick-agent-item" data-id="{{item.id}}" bindtap="onQuickAgentTap">
                <view class="quick-agent-icon" style="background-color: {{item.color}};">
                  <text class="quick-agent-icon-text">{{item.icon}}</text>
                </view>
                <text class="quick-agent-name">{{item.name}}</text>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <!-- 快捷Skills入口 -->
      <view class="quick-skills-section">
        <text class="section-label">SKILLS</text>
        <scroll-view class="quick-skills-scroll" scroll-x>
          <view class="quick-skills-list">
            <block wx:for="{{hotSkills}}" wx:key="id">
              <view class="quick-skill-item" data-id="{{item.id}}" bindtap="onQuickSkillTap">
                <view class="quick-skill-icon" style="background-color: {{item.color}};">
                  <text class="quick-skill-icon-text">{{item.icon}}</text>
                </view>
                <text class="quick-skill-name">{{item.name}}</text>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>
    </view>
    
    <!-- 历史对话下拉头部 - 横贯全屏 -->
    <view class="history-header" bindtap="onHistoryTap">
      <block wx:if="{{!isHistoryExpanded}}">
        <!-- 收起状态 -->
        <view class="history-inline-row">
          <view class="history-indicator"></view>
          <text class="history-label-inline">历史对话</text>
          <text class="history-topic-inline">{{lastTopic || '新对话'}}</text>
          <text class="history-time-inline">{{lastTime || ''}}</text>
        </view>
      </block>
      <block wx:if="{{isHistoryExpanded}}">
        <!-- 展开状态 -->
        <view class="history-expanded-header">
          <view class="history-indicator"></view>
          <text class="history-label-inline">历史对话</text>
          <text class="history-topic-inline">{{lastTopic || '新对话'}}</text>
          <text class="history-time-inline">{{lastTime || ''}}</text>
        </view>
        <view class="history-list">
          <block wx:for="{{historyList}}" wx:key="index">
            <view class="history-item" data-index="{{index}}" catchtap="onHistoryItemTap">
              <text class="history-item-topic">{{item.topic}}</text>
              <text class="history-item-time">{{item.time}}</text>
              <view class="history-item-delete" catchtap="onDeleteHistory" data-index="{{index}}">✕</view>
            </view>
          </block>
          <block wx:if="{{historyList.length === 0}}">
            <view class="history-empty">暂无历史对话</view>
          </block>
        </view>
      </block>
    </view>
    
    <!-- 聊天消息区域 -->
    <view class="chat-messages-section" id="chat-messages" bindtap="onCollapseHistory">
      <block wx:if="{{messages.length === 0}}">
        <!-- 欢迎提示 -->
        <view class="welcome-message">
          <image class="welcome-icon" src="/images/ai-assistant.png" mode="aspectFit"></image>
          <text class="welcome-title">欢迎使用安粮期货投研助手</text>
          <text class="welcome-description">我是您的专业期货投研智能体，可以为您提供：</text>
          <view class="welcome-features">
            <text class="feature-item">📊 期货品种深度分析</text>
            <text class="feature-item">🎯 交易策略设计与回测</text>
            <text class="feature-item">📰 实时市场资讯搜索</text>
            <text class="feature-item">⚠️ 风险评估与管理建议</text>
            <text class="feature-item">💰 资金管理与仓位规划</text>
          </view>
          <text class="welcome-tip">请直接输入您的问题，或点击上方智能体快速提问</text>
        </view>
      </block>
      
      <!-- 消息列表 -->
      <block wx:if="{{messages.length > 0}}">
        <block wx:for="{{messages}}" wx:key="index">
          <!-- 用户消息 -->
          <block wx:if="{{item.role === 'user'}}">
            <view class="message-item user-message">
              <view class="message-content user-content">
                <text class="message-text" user-select="{{true}}">{{item.content}}</text>
              </view>
              <view class="message-avatar user-avatar">
                <image class="avatar-img" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
              </view>
            </view>
          </block>
          
          <!-- AI消息 -->
          <block wx:if="{{item.role === 'assistant'}}">
            <view class="message-item assistant-message">
              <view class="message-avatar assistant-avatar">
                <image class="avatar-img" src="/images/avatar-ai.png" mode="aspectFill"></image>
              </view>
              <view class="message-content assistant-content">
                <text class="message-text" user-select="{{true}}">{{item.content}}</text>
                <block wx:if="{{item.agent_used}}">
                  <view class="message-agent-tag">🤖 {{item.agent_used}}</view>
                </block>
                <block wx:if="{{item.suggested_agents && item.suggested_agents.length > 0}}">
                  <view class="suggested-agents">
                    <text class="suggested-title">推荐智能体：</text>
                    <view class="suggested-tags">
                      <block wx:for="{{item.suggested_agents}}" wx:key="*this">
                        <text class="suggested-tag" data-agent="{{item}}" bindtap="onSuggestedAgentTap">{{item}}</text>
                      </block>
                    </view>
                  </view>
                </block>
              </view>
            </view>
          </block>
        </block>
      </block>
      
      <!-- 加载状态 -->
      <block wx:if="{{loading}}">
        <view class="loading-message">
          <view class="loading-avatar">
            <image class="avatar-img" src="/images/avatar-ai.png" mode="aspectFill"></image>
          </view>
          <view class="loading-content">
            <view class="loading-dots">
              <text class="loading-dot">.</text>
              <text class="loading-dot">.</text>
              <text class="loading-dot">.</text>
            </view>
            <text class="loading-text">智能体思考中</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 输入区域 - 放在TabBar上方 -->
  <view class="input-section" bindtap="onCollapseHistory">
    <!-- 附件预览区域 -->
    <view class="attach-preview" wx:if="{{attachList.length > 0}}">
      <block wx:for="{{attachList}}" wx:key="index">
        <view class="attach-item">
          <image wx:if="{{item.type === 'image'}}" class="attach-thumb" src="{{item.path}}" mode="aspectFill"></image>
          <view wx:else class="attach-file">
            <text class="attach-file-icon">📄</text>
            <text class="attach-file-name">{{item.name}}</text>
          </view>
          <view class="attach-remove" bindtap="onRemoveAttach" data-index="{{index}}">✕</view>
        </view>
      </block>
    </view>
    <!-- 输入框和按钮区域 -->
    <view class="input-row">
      <!-- 附件按钮 -->
      <view class="attach-btn" bindtap="onAttachTap" hover-class="none">
        <text class="attach-icon">📎</text>
      </view>
      <view class="input-container">
        <textarea
          class="chat-input"
          placeholder="请输入您的问题..."
          value="{{inputValue}}"
          bindinput="onInput"
          adjust-position="{{false}}"
          disabled="{{loading}}"
          auto-height
          maxlength="500"
        />
        <!-- 语音输入按钮 -->
        <view class="voice-btn {{isRecording ? 'recording' : ''}}" bindtap="onVoiceTap" hover-class="none">
          <text class="voice-icon">{{isRecording ? '⏹' : '🎤'}}</text>
        </view>
        <button class="send-button" bindtap="onSend" hover-class="none" disabled="{{loading || !inputValue}}">
          <text class="send-icon">{{loading ? '⏳' : '发送'}}</text>
        </button>
      </view>
    </view>
    <view class="input-tips">
      <text class="input-tip">支持：期货分析、策略设计、资讯查询、风险计算等</text>
    </view>
  </view>
  
  <!-- 科技感自定义TabBar -->
  <custom-tabbar 
    currentTab="{{currentTabIndex}}"
    bind:tabchange="onTabChange"
  />
</view>