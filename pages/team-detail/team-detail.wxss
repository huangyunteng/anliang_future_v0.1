/* pages/team-detail/team-detail.wxss - 团队成员详情页样式 */

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* ========== 顶部红色区域 ========== */
.header-section {
  background: linear-gradient(135deg, #C8102E 0%, #A00D25 100%);
  padding: 30rpx 30rpx 50rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-right: 20rpx solid #FFFFFF;
}

.header-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ========== 成员信息卡片 ========== */
.member-card {
  background-color: #FFFFFF;
  margin: -30rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  background-color: #F5F5F5;
}

.avatar-frame {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border: 4rpx solid #C8102E;
  border-radius: 50%;
  z-index: 2;
}

/* 基本信息 */
.info-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.member-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.member-position {
  font-size: 28rpx;
  color: #C8102E;
  display: block;
  padding: 8rpx 24rpx;
  background-color: rgba(200, 16, 46, 0.1);
  border-radius: 20rpx;
  display: inline-block;
}

/* 资质信息 */
.credentials-section {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.credential-item {
  text-align: center;
}

.credential-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 6rpx;
}

.credential-value {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

/* ========== 个人简介 ========== */
.intro-section {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.intro-content {
  padding: 24rpx 30rpx 30rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: 50rpx;
}
